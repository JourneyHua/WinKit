<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:core="clr-namespace:WinKit.Core">

    <!--
        字号刻度（不要再用其它值）：
          11 辅助 / 12 次要 / 13 正文 / 15 小标题 / 20 标题 / 32 记分
    -->

    <!-- 共享列宽：操作列统一 3 档，侧栏统一 210 -->
    <DataGridLength x:Key="OpCol.Narrow">90</DataGridLength>
    <DataGridLength x:Key="OpCol">196</DataGridLength>
    <DataGridLength x:Key="OpCol.Wide">240</DataGridLength>
    <sys:Double x:Key="SideList.Width">210</sys:Double>
    <DataGridLength x:Key="CheckCol.Width">56</DataGridLength>

    <!-- ========== 表格单元格文本（原先 18 个视图各写一份，共 36 份） ========== -->

    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="CellMuted" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- 第三级：表格里的补充说明（原先是散落的 FontSize=11） -->
    <Style x:Key="CellSub" TargetType="TextBlock" BasedOn="{StaticResource CellMuted}">
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- ========== 计数器徽章（原先 5 处硬编码 #FFF1EFE8） ========== -->

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Badge}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The track stays fixed. Only its paint changes; indeterminate work needs no repeating clock. -->
    <Style x:Key="QuietProgress" TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="Fill" Background="{TemplateBinding Foreground}" CornerRadius="2"
                                core:Motion.ProgressPercent="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform>
                        </Border>
                        <Border x:Name="Busy" Background="{TemplateBinding Foreground}" CornerRadius="2"
                                HorizontalAlignment="Left" Width="42" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="Fill" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 空状态：数据为空时显示，替代 21 页里 15 页的"一片白" ========== -->

    <Style x:Key="EmptyState" TargetType="TextBlock">
        <Setter Property="core:Motion.Reveal" Value="True" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="24" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ========== 忙碌遮罩：扫描时盖住内容区，避免"点了没反应" ========== -->

    <Style x:Key="BusyOverlay" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
        <Setter Property="Opacity" Value="0.88" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="BusyText" TargetType="TextBlock">
        <Setter Property="core:Motion.Reveal" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- ========== 错误条：失败时统一展示，带重试提示 ========== -->

    <Style x:Key="ErrorBar" TargetType="Border">
        <Setter Property="core:Motion.Reveal" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerSoftBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>


    <Style x:Key="Display" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <!-- ========== 提示卡：统一 3 种语义（原先手写 12 份、3 种配色、2 种内边距） ========== -->

    <Style x:Key="HintCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentSoftBorder}" />
    </Style>

    <Style x:Key="HintCard.Warn" TargetType="Border" BasedOn="{StaticResource HintCard}">
        <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarnSoftBorder}" />
    </Style>

    <Style x:Key="HintCard.Danger" TargetType="Border" BasedOn="{StaticResource HintCard}">
        <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerSoftBorder}" />
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <Style x:Key="HintText.Warn" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
    </Style>

    <Style x:Key="HintText.Danger" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>


    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="core:Motion.FeedbackBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <Grid>
                            <Border x:Name="Feedback" CornerRadius="5" Opacity="0" IsHitTestVisible="False"
                                    Background="{Binding Path=(core:Motion.FeedbackBrush), RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Feedback" Property="core:Motion.Level" Value="0.07" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Feedback" Property="core:Motion.Level" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Feedback" Property="core:Motion.Level" Value="0" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="core:Motion.FeedbackBrush" Value="Black" />
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
    </Style>

    <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Border x:Name="SelectedFill" Background="{DynamicResource Brush.AccentSoft}"
                                    CornerRadius="11" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="Feedback" Background="{DynamicResource Brush.Text}"
                                    CornerRadius="11" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Feedback" Property="core:Motion.Level" Value="0.07" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Feedback" Property="core:Motion.Level" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SelectedFill" Property="core:Motion.Level" Value="1" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Feedback" Property="core:Motion.Level" Value="0" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The check mark is decoration. Toggle state, focus and the hit target keep native control semantics. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="16" Height="16" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Border x:Name="Box" CornerRadius="4" Background="{DynamicResource Brush.Window}"
                                    BorderBrush="{DynamicResource Brush.TextMuted}" BorderThickness="1" />
                            <Border x:Name="CheckInk" CornerRadius="4" Background="{DynamicResource Brush.Accent}" Opacity="0" IsHitTestVisible="False">
                                <Grid>
                                    <Path x:Name="Tick" Data="M 2,6 L 5,9 L 11,2" Stretch="Uniform" Width="10" Height="8"
                                          Stroke="{DynamicResource Brush.OnAccent}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <Border x:Name="Mixed" Width="8" Height="2" CornerRadius="1"
                                            Background="{DynamicResource Brush.OnAccent}" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Border x:Name="FocusRing" CornerRadius="4" BorderBrush="{DynamicResource Brush.Text}"
                                    BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="7,0,0,0" RecognizesAccessKey="True"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckInk" Property="core:Motion.Level" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="CheckInk" Property="core:Motion.Level" Value="1" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Mixed" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        列宽拖拽手柄。自定义 DataGridColumnHeader 模板会整体替换默认模板，
        而默认模板里的 PART_LeftHeaderGripper / PART_RightHeaderGripper 一旦缺失，
        DataGrid 就完全拖不动列宽（鼠标移到列边界连光标都不变）。
        两个 Thumb 必须用这两个固定名字，DataGrid 靠它们找手柄。
    -->
    <Style x:Key="ColumnHeaderGripper" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="GripBd" Background="{TemplateBinding Background}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GripBd" Property="Background" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="HdrBd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <!-- Use the existing right inset; sorting never changes the label's available width. -->
                        <TextBlock x:Name="SortArrow" Text="▲" FontSize="9" Margin="0,0,4,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                        <!--
                            列宽拖拽手柄。名字必须是这两个固定名，DataGrid 靠名字找它们；
                            少了任何一个，鼠标移到列边界连 SizeWE 光标都不会出现。
                        -->
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                               Style="{StaticResource ColumnHeaderGripper}" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                               Style="{StaticResource ColumnHeaderGripper}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HdrBd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="core:Motion.Angle" Value="180" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GridCell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="34" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Grid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <!-- 允许拖动列边界改宽度：配合 GridHeader 模板里的两个 gripper 才真正生效 -->
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="MinColumnWidth" Value="40" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource GridCell}" />
        <Setter Property="RowStyle" Value="{StaticResource GridRow}" />
    </Style>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="8,2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 层级规范：刷新一律灰按钮，蓝色只留给"执行/应用" ========== -->

    <Style x:Key="RefreshBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Padding" Value="14,6" />
    </Style>

    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource BtnDanger}">
        <Setter Property="Padding" Value="14,6" />
    </Style>
</ResourceDictionary>
