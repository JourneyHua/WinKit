<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Window">#FFF3F3F3</Color>
    <Color x:Key="Color.Card">#FFFFFFFF</Color>
    <Color x:Key="Color.Border">#FFE3E3E3</Color>
    <Color x:Key="Color.Text">#FF1B1B1B</Color>
    <Color x:Key="Color.TextMuted">#FF6B6B6B</Color>
    <Color x:Key="Color.Accent">#FF0F6CBD</Color>
    <Color x:Key="Color.AccentSoft">#FFE6F1FB</Color>
    <Color x:Key="Color.Danger">#FFC42B1C</Color>
    <Color x:Key="Color.DangerSoft">#FFFDE7E9</Color>
    <Color x:Key="Color.Warn">#FF9D5D00</Color>
    <Color x:Key="Color.WarnSoft">#FFFFF4CE</Color>
    <Color x:Key="Color.Success">#FF0F7B0F</Color>
    <Color x:Key="Color.SuccessSoft">#FFE8F5E8</Color>
    <Color x:Key="Color.Hover">#FFEDEDED</Color>
    <Color x:Key="Color.Selected">#FFE8F1FB</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
    <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}" />
    <SolidColorBrush x:Key="Brush.WarnSoft" Color="{StaticResource Color.WarnSoft}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Selected" Color="{StaticResource Color.Selected}" />

    <!-- 提示卡边框与徽章底：原先散落在 21 个视图里的硬编码色 -->
    <SolidColorBrush x:Key="Brush.AccentSoftBorder" Color="#FFC9D5F8" />
    <SolidColorBrush x:Key="Brush.WarnSoftBorder" Color="#FFE8C46B" />
    <SolidColorBrush x:Key="Brush.DangerSoftBorder" Color="#FFF3B7B7" />
    <SolidColorBrush x:Key="Brush.Badge" Color="#FFF1EFE8" />

</ResourceDictionary>
