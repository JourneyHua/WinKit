<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        深色主题。key 必须与 Colors.xaml 完全一致：
        切换主题的做法是整体替换 MergedDictionaries，而不是改画刷颜色
        （XAML 里的 SolidColorBrush 会被自动冻结，运行时改 Color 会抛异常）。
    -->

    <Color x:Key="Color.Window">#FF1B1B1B</Color>
    <Color x:Key="Color.Card">#FF252525</Color>
    <Color x:Key="Color.Border">#FF3A3A3A</Color>
    <Color x:Key="Color.Text">#FFF2F2F2</Color>
    <Color x:Key="Color.TextMuted">#FFA0A0A0</Color>
    <Color x:Key="Color.Accent">#FF60CDFF</Color>
    <Color x:Key="Color.AccentSoft">#FF1F3A4D</Color>
    <Color x:Key="Color.Danger">#FFFF6B5E</Color>
    <Color x:Key="Color.DangerSoft">#FF43201E</Color>
    <Color x:Key="Color.Warn">#FFF2C94C</Color>
    <Color x:Key="Color.WarnSoft">#FF3D3218</Color>
    <Color x:Key="Color.Success">#FF6CCB5F</Color>
    <Color x:Key="Color.SuccessSoft">#FF1F3A1E</Color>
    <Color x:Key="Color.Hover">#FF2F2F2F</Color>
    <Color x:Key="Color.Selected">#FF2D3F52</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
    <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}" />
    <SolidColorBrush x:Key="Brush.WarnSoft" Color="{StaticResource Color.WarnSoft}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Selected" Color="{StaticResource Color.Selected}" />

    <!-- 提示卡边框与徽章底：原先散落在 21 个视图里的硬编码色 -->
    <SolidColorBrush x:Key="Brush.AccentSoftBorder" Color="#FF2A5A7A" />
    <SolidColorBrush x:Key="Brush.WarnSoftBorder" Color="#FF6B5520" />
    <SolidColorBrush x:Key="Brush.DangerSoftBorder" Color="#FF6B2E2A" />
    <SolidColorBrush x:Key="Brush.Badge" Color="#FF3A3A3A" />

</ResourceDictionary>
