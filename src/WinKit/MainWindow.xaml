<Window x:Class="WinKit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinKit 系统管家"
        Height="780" Width="1200" MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Brush.Card}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,22,20,14">
                    <TextBlock Text="WinKit" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="系统管家" FontSize="12" Margin="0,2,0,0"
                               Foreground="{StaticResource Brush.TextMuted}" />
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="2"
                                        Background="{Binding AccentBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="20,10,20,16">
                    <TextBlock Text="{Binding ElevationText}" Style="{StaticResource Muted}" />
                    <Button Content="以管理员身份重启" Style="{StaticResource BtnSmall}" Margin="0,6,0,2"
                            HorizontalAlignment="Left"
                            Visibility="{Binding ShowElevateButton, Converter={StaticResource BoolToVis}}"
                            Command="{Binding ElevateCommand}" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="24,18,24,14"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource H1}" />
                        <TextBlock Text="{Binding CurrentSubtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="撤销上一步" Style="{StaticResource BtnBase}"
                                Command="{Binding UndoCommand}" Margin="0,0,8,0" />
                        <Button Content="重启资源管理器" Style="{StaticResource BtnBase}"
                                Command="{Binding RestartExplorerCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0" Height="3" IsIndeterminate="True" BorderThickness="0"
                             Background="Transparent" Foreground="{StaticResource Brush.Accent}"
                             Visibility="{Binding IsGlobalBusy, Converter={StaticResource BoolToVis}}" />
                <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="0" />
            </Grid>

            <Border Grid.Row="2" Padding="20,8" Background="{StaticResource Brush.Card}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding BackupHint}" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
