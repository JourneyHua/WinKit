<Window x:Class="WinKit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinKit.Views"
        xmlns:core="clr-namespace:WinKit.Core"
        Title="WinKit 系统管家"
        Height="820" Width="1280" MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <DataTemplate x:Key="NavRow">
            <Button x:Name="NavRowButton" Margin="8,1" Click="NavRow_Click"
                    IsEnabled="{Binding DataContext.IsNavigationEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.Name="{Binding Title}"
                    AutomationProperties.HelpText="{Binding Subtitle}"
                    AutomationProperties.AutomationId="{Binding Key}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                        <Setter Property="ToolTip" Value="{Binding Subtitle}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter Property="AutomationProperties.ItemStatus" Value="当前页面" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="ToolTip" Value="{Binding DataContext.NavigationHint, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <DockPanel>
                    <TextBlock Text="{Binding Glyph}" DockPanel.Dock="Left"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Width="22"
                               VerticalAlignment="Center" Foreground="{Binding AccentBrush}"
                               Visibility="{Binding DataContext.ShowNavIcons, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid SizeChanged="LayoutRoot_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧：分组导航 ============ -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,17,16,8">
                    <TextBlock Text="WinKit" FontSize="18" FontWeight="SemiBold" Margin="4,0,0,10"
                               Foreground="{DynamicResource Brush.Text}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="清除" Style="{StaticResource BtnSmall}"
                                Command="{Binding ClearNavSearchCommand}" Click="ClearNavSearch_Click" Margin="4,0,0,0"
                                AutomationProperties.Name="清除工具搜索"
                                Visibility="{Binding HasNavSearchText, Converter={StaticResource BoolToVis}}" />
                        <Grid>
                            <TextBox x:Name="NavSearchBox" Style="{StaticResource SearchBox}"
                                     Text="{Binding NavSearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="NavSearchBox_KeyDown"
                                     AutomationProperties.Name="搜索工具" />
                            <TextBlock Text="搜索工具" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNavSearchText}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <TextBlock Text="没找到工具。试试「清理」或「PATH」。" Style="{StaticResource Muted}"
                               Margin="16,8" TextWrapping="Wrap"
                               Visibility="{Binding ShowNoNavResults, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding NavSearchResults}" ItemTemplate="{StaticResource NavRow}"
                                  Visibility="{Binding IsNavSearchActive, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding NavGroups}" Margin="0,0,0,4">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNavSearchActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- 分组标题（可折叠） -->
                                    <Button Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource NavButton}"
                                            AutomationProperties.Name="{Binding Name}"
                                            Padding="0" Margin="7,0">
                                        <Border Padding="18,8,14,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="2" FontSize="10" Text="&#xE70D;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           Foreground="{DynamicResource Brush.TextMuted}"
                                                           VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                    <Setter Property="core:Motion.Angle" Value="-90" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <!-- 分组内容 -->
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource NavRow}"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="20,10,20,14">
                    <TextBlock Text="{Binding ElevationText}" Style="{StaticResource Muted}" />

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding VersionText}" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" />
                        <!-- 设置入口：主题、表格密度与更新偏好。 -->
                        <Button Grid.Column="1" x:Name="SettingsButton"
                                Style="{StaticResource BtnSmall}" Padding="8,3"
                                Click="SettingsButton_Click" ToolTip="主题、表格密度和更新偏好"
                                Content="设置" />
                    </Grid>
                    <Button Content="{Binding Updater.EntryText}" Command="{Binding Updater.EntryCommand}"
                            Style="{StaticResource BtnSmall}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 右侧：内容区 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="24,16,24,12"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="PageHeading" Grid.Column="0" core:Motion.Context="{Binding CurrentViewModel}">
                        <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource H1}" />
                        <TextBlock Text="{Binding CurrentSubtitle}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="撤销上一步" Style="{StaticResource BtnBase}"
                                Visibility="{Binding HasUndo, Converter={StaticResource BoolToVis}}"
                                Command="{Binding UndoCommand}" ToolTip="{Binding UndoHint}"
                                AutomationProperties.HelpText="{Binding UndoHint}" ToolTipService.ShowOnDisabled="True" />
                        <Button Content="重启资源管理器" Style="{StaticResource BtnBase}"
                                Visibility="{Binding ShowRestartExplorer, Converter={StaticResource BoolToVis}}"
                                Margin="8,0,0,0" Command="{Binding RestartExplorerCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="16,8,16,0" core:Motion.Reveal="True"
                        core:Motion.Context="{Binding FeedbackMessage}"
                        Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource HintCard}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FeedbackIsError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerSoftBorder}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer MaxHeight="112" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding FeedbackMessage}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                        </ScrollViewer>
                        <Button Grid.Column="1" Content="关闭提示" Style="{StaticResource BtnSmall}"
                                Command="{Binding DismissFeedbackCommand}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 仅在包含受限操作的页面说明权限；浏览页面不触发模态提权提示。 -->
                <Border Grid.Row="1" Margin="16,8,16,0" Padding="14,8" CornerRadius="6" core:Motion.Reveal="True"
                        Background="{DynamicResource Brush.Card}"
                        BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="3,0,0,0"
                        Visibility="{Binding ShowElevationBanner, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ElevationBannerText}" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="以管理员身份重新启动" Style="{StaticResource BtnPrimary}"
                                Command="{Binding ElevateCommand}" Margin="12,0,0,0"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource HintCard}" Margin="16,8,16,8" core:Motion.Reveal="True"
                            Visibility="{Binding IsClosePending, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="取消关闭" Style="{StaticResource BtnSmall}"
                                    Command="{Binding CancelCloseCommand}" Margin="12,0,0,0" />
                            <TextBlock Text="当前操作完成后将关闭窗口。" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                    </Border>
                    <Grid Height="3">
                        <ProgressBar Style="{StaticResource QuietProgress}" IsIndeterminate="True"
                                     Background="Transparent" AutomationProperties.Name="正在处理"
                                     core:Motion.Reveal="True"
                                     Visibility="{Binding IsGlobalBusy, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </StackPanel>
                <views:AppUpdateView Grid.Row="3" DataContext="{Binding Updater}" />
                <ContentControl Grid.Row="4" Content="{Binding CurrentViewModel}" Margin="0" IsEnabled="{Binding IsMainContentEnabled}" />
            </Grid>

            <Border Grid.Row="2" Padding="24,8" Background="{DynamicResource Brush.Card}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Left" Text="正在处理 · " Style="{StaticResource Muted}" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding IsGlobalBusy, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   ToolTip="{Binding StatusText}" />
                    </DockPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SessionHint}" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="240"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding UndoHint}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 设置浮层 ============ -->
        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Right" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource Brush.Card}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="8" Padding="16,14" Margin="8,0,0,0"
                    Width="260">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.18" />
                </Border.Effect>
                <StackPanel core:Motion.Reveal="True" core:Motion.IsPopupSurface="True">
                    <TextBlock Text="外观" Style="{StaticResource H2}" Margin="0,0,0,8" />

                    <TextBlock Text="主题" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ToggleButton x:Name="ThemeSystem" Content="跟随系统" Style="{StaticResource Chip}"
                                      Margin="0,0,4,0" Click="Theme_Click" Tag="System" />
                        <ToggleButton x:Name="ThemeLight" Content="浅色" Style="{StaticResource Chip}"
                                      Margin="0,0,4,0" Click="Theme_Click" Tag="Light" />
                        <ToggleButton x:Name="ThemeDark" Content="深色" Style="{StaticResource Chip}"
                                      Click="Theme_Click" Tag="Dark" />
                    </StackPanel>

                    <TextBlock Text="表格密度" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="DensityCompact" Content="紧凑" Style="{StaticResource Chip}"
                                      Margin="0,0,4,0" Click="Density_Click" Tag="Compact" />
                        <ToggleButton x:Name="DensityComfortable" Content="舒适" Style="{StaticResource Chip}"
                                      Click="Density_Click" Tag="Comfortable" />
                    </StackPanel>
                    <Separator Margin="0,14,0,12" />
                    <TextBlock Text="WinKit 更新" Style="{StaticResource H2}" Margin="0,0,0,8" />
                    <CheckBox IsChecked="{Binding Updater.AutomaticChecksEnabled, Mode=TwoWay}" Margin="0,0,0,6">
                        <TextBlock Text="自动检查正式版更新" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="最多每天检查一次。有新版时只更新左下角的入口，不自动下载或重启。"
                               Style="{StaticResource Muted}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
