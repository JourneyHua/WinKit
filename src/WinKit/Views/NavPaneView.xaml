<UserControl x:Class="WinKit.Views.NavPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="24,16,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,14"
                    Background="{StaticResource Brush.DangerSoft}" BorderBrush="#FFF3B7B7"
                    Visibility="{Binding StubbornGroups.Count, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}">
                <StackPanel>
                    <TextBlock Text="顽固节点（会自动重建）" Style="{StaticResource H2}"
                               Foreground="{StaticResource Brush.Danger}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                               Foreground="{StaticResource Brush.Danger}"
                               Text="同一名字注册了多个 GUID，说明软件每次启动都换新号重新钉上去，按单个 ID 关追不上。这里可以一次清干净，并揪出重建它的进程。" />

                    <ItemsControl ItemsSource="{Binding StubbornGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FFF3B7B7" BorderThickness="0,0,0,1" Padding="2,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                       Foreground="{StaticResource Brush.Text}" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource Brush.TextMuted}"
                                                       TextWrapping="Wrap" Margin="0,2,8,0">
                                                <Run Text="{Binding GuidCount, Mode=OneWay}" /><Run Text=" 个 GUID · 重建进程：" /><Run Text="{Binding ProcessText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="结束进程" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.StopRebuilderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="彻底清理" Style="{StaticResource BtnSmall}"
                                                    Foreground="{StaticResource Brush.Danger}"
                                                    Command="{Binding DataContext.PurgeStubbornCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="导航栏固定项（软件节点）" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                               Text="iCloud、网盘、应用宝这类软件自己钉在资源管理器左侧的节点。取消勾选即从导航栏消失，只改一个标志位（IsPinnedToNameSpaceTree），随时可恢复。" />

                    <ScrollViewer MaxHeight="228" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PinnedFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                                        Padding="2,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanToggle}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                                  Cursor="Hand" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                       Foreground="{StaticResource Brush.Text}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding OwnerText}" FontSize="11"
                                                       Foreground="{StaticResource Brush.TextMuted}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12"
                                                   Foreground="{StaticResource Brush.TextMuted}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="没有检测到被软件钉住的导航栏节点" Style="{StaticResource Muted}"
                               Margin="0,8,0,0"
                               Visibility="{Binding PinnedFolders.Count, Converter={StaticResource EmptyToVis}}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,14,16,8">
                        <TextBlock Text="快速访问固定项" Style="{StaticResource H2}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="这里的顺序即资源管理器左侧的顺序。增删即时生效；“最近使用”的条目请用右键菜单取消。" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,8">
                        <Button Content="固定文件夹…" Style="{StaticResource BtnPrimary}" Command="{Binding PinCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="应用新顺序" Style="{StaticResource BtnBase}" Command="{Binding ApplyOrderCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="刷新" Style="{StaticResource BtnBase}" Command="{Binding RefreshCommand}" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding Pinned}" Background="Transparent" BorderThickness="0"
                                 Margin="8,0,8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{StaticResource Brush.Hover}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                           Foreground="{StaticResource Brush.Text}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Background="#FFF1EFE8" CornerRadius="6" Padding="5,1"
                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding KindText}" FontSize="10"
                                                               Foreground="{StaticResource Brush.TextMuted}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" FontSize="11"
                                                       Foreground="{StaticResource Brush.TextMuted}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="打开" Style="{StaticResource BtnSmall}" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="↑" Style="{StaticResource BtnSmall}" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="↓" Style="{StaticResource BtnSmall}" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="取消固定" Style="{StaticResource BtnSmall}"
                                                    Foreground="{StaticResource Brush.Danger}"
                                                    Command="{Binding DataContext.UnpinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="快速访问当前为空" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Pinned.Count, Converter={StaticResource EmptyToVis}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Column="1">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                    Background="{StaticResource Brush.DangerSoft}" BorderBrush="#FFF3B7B7"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="无法读取快速访问" Style="{StaticResource H2}"
                               Foreground="{StaticResource Brush.Danger}" />
                    <TextBlock Text="{Binding LoadError}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                               Foreground="{StaticResource Brush.Danger}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Foreground="{StaticResource Brush.Danger}"
                               Text="上面的固定项开关不受影响，仍可正常使用。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="导航窗格选项" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                               Text="这些是资源管理器自身的开关，改完可能需要重启资源管理器。" />

                    <ItemsControl ItemsSource="{Binding Toggles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                                        Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       Foreground="{StaticResource Brush.Text}" />
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       Foreground="{StaticResource Brush.TextMuted}"
                                                       TextWrapping="Wrap" Margin="0,2,8,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Cursor="Hand" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="重启资源管理器" Style="{StaticResource BtnBase}" Margin="0,14,0,0"
                            HorizontalAlignment="Left" Command="{Binding RestartExplorerCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
