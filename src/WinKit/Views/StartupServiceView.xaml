<UserControl x:Class="WinKit.Views.StartupServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">


    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <ToggleButton Content="开机启动项" Style="{StaticResource Chip}" Margin="0,0,6,0"
                              IsChecked="{Binding ShowStartup, Mode=OneWay}"
                              Command="{Binding ShowStartupViewCommand}" />
                <ToggleButton Content="后台服务" Style="{StaticResource Chip}" Margin="0,0,6,0"
                              IsChecked="{Binding ShowServices, Mode=OneWay}"
                              Command="{Binding ShowServicesViewCommand}" />
                <ToggleButton Content="计划任务" Style="{StaticResource Chip}" Margin="0,0,10,0"
                              IsChecked="{Binding ShowTasks, Mode=OneWay}"
                              Command="{Binding ShowTasksViewCommand}" />
                <ToggleButton Content="仅看第三方" Style="{StaticResource Chip}"
                              IsChecked="{Binding OnlyThirdParty, Mode=TwoWay}" />
            </StackPanel>

            <Grid Grid.Column="1" Margin="0,0,12,0">
                <TextBox Style="{StaticResource SearchBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="搜索名称 / 发布者 / 命令路径…" Margin="12,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           FontSize="13" Foreground="{DynamicResource Brush.TextMuted}"
                           Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="系统服务 (services.msc)" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                        Visibility="{Binding ShowServices, Converter={StaticResource BoolToVis}}"
                        Command="{Binding OpenServicesMscCommand}" />
                <Button Content="任务计划 (taskschd.msc)" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                        Visibility="{Binding ShowTasks, Converter={StaticResource BoolToVis}}"
                        Command="{Binding OpenTaskSchedulerCommand}" />
                <Button Content="重新扫描" Style="{StaticResource BtnBase}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10"
                Background="{DynamicResource Brush.WarnSoft}" BorderBrush="{DynamicResource Brush.WarnSoftBorder}">
            <TextBlock Style="{StaticResource Muted}" Foreground="{DynamicResource Brush.Warn}"
                       Text="默认过滤微软系统核心项（仅展示第三方软件自启、后台服务与计划任务）。开机启动项通过系统原生 StartupApproved 机制无损切换启用/禁用；服务修改自启类型前自动记录注册表快照，可随时撤销。" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding SummaryText}" Style="{StaticResource Muted}"
                           Margin="14,10,14,6" />

                <!-- 1. 开机启动项表 -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Startups}" Style="{StaticResource Grid}"
                          Visibility="{Binding ShowStartup, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="启用" Width="54" SortMemberPath="IsEnabled">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="启动项名称" Width="1.4*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}"
                                               ToolTip="{Binding CopyablePath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="发布者" Width="1*" SortMemberPath="Publisher">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Publisher}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="位置来源" Width="135" SortMemberPath="LocationTitle">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LocationTitle}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="启动命令" Width="2*" SortMemberPath="Command">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Command}" Style="{StaticResource CellMuted}"
                                               ToolTip="{Binding Command}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="状态" Width="110" SortMemberPath="StatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="195" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="目录" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                                IsEnabled="{Binding HasExecutable}"
                                                Command="{Binding DataContext.OpenStartupFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="定位" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.OpenStartupRegeditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="删除" Style="{StaticResource BtnSmall}"
                                                Foreground="{DynamicResource Brush.Danger}"
                                                Command="{Binding DataContext.DeleteStartupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 2. 后台服务表 -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Services}" Style="{StaticResource Grid}"
                          Visibility="{Binding ShowServices, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="服务显示名" Width="1.6*" SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CellText}"
                                               ToolTip="{Binding Description}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="服务名" Width="1.1*" SortMemberPath="ServiceName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ServiceName}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="发布者" Width="1*" SortMemberPath="Publisher">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Publisher}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="运行状态" Width="86" SortMemberPath="StateText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="启动类型" Width="80" SortMemberPath="StartTypeText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StartTypeText}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="程序路径" Width="1.6*" SortMemberPath="ImagePath">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ImagePath}" Style="{StaticResource CellMuted}"
                                               ToolTip="{Binding ImagePath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="205" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding RunToggleText}" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.ToggleServiceRunCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="改自启" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.ChangeServiceStartTypeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="定位" Style="{StaticResource BtnSmall}"
                                                Command="{Binding DataContext.OpenServiceRegeditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 3. 计划任务表 -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Tasks}" Style="{StaticResource Grid}"
                          Visibility="{Binding ShowTasks, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="任务名称" Width="1.4*" SortMemberPath="TaskName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TaskName}" Style="{StaticResource CellText}"
                                               ToolTip="{Binding FullPath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="任务目录" Width="1.1*" SortMemberPath="TaskPath">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TaskPath}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="作者" Width="1*" SortMemberPath="Author">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Author}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="执行命令" Width="2*" SortMemberPath="Command">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Command}" Style="{StaticResource CellMuted}"
                                               ToolTip="{Binding Command}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="状态" Width="80" SortMemberPath="StateText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="165" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding ToggleButtonText}" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="立即运行" Style="{StaticResource BtnSmall}"
                                                Command="{Binding DataContext.RunTaskNowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <!-- 页面级错误条：失败时统一展示，替代原先只靠底部状态栏 -->
        <Border Style="{StaticResource ErrorBar}" VerticalAlignment="Top"
                Panel.ZIndex="99" Margin="24,8,24,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" />
        </Border>
    </Grid>
</UserControl>
