<UserControl x:Class="WinKit.Views.SystemTweakView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">


    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Content="Win11 系统调优开关" Style="{StaticResource Chip}" Margin="0,0,6,0"
                              IsChecked="{Binding ShowTweaksView, Mode=OneWay}"
                              Command="{Binding ShowTweaksViewCommand}" />
                <ToggleButton Content="网络与端口占用诊断" Style="{StaticResource Chip}" Margin="0,0,6,0"
                              IsChecked="{Binding ShowPortsView, Mode=OneWay}"
                              Command="{Binding ShowPortsViewCommand}" />
                <ToggleButton Content="系统深层面板直达 (16 项)" Style="{StaticResource Chip}"
                              IsChecked="{Binding ShowPanelsView, Mode=OneWay}"
                              Command="{Binding ShowPanelsViewCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ShowTweaksView, Converter={StaticResource BoolToVis}}">
                <Button Content="重启资源管理器" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                        Command="{Binding RestartExplorerCommand}" />
                <Button Content="刷新状态" Style="{StaticResource BtnBase}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- 子视图 1：Win11 系统调优开关 -->
        <Grid Grid.Row="1" Visibility="{Binding ShowTweaksView, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10"
                    Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.AccentSoftBorder}">
                <TextBlock Style="{StaticResource Muted}" Foreground="{DynamicResource Brush.Accent}"
                           Text="汇总 15 项最常用的 Windows 11 资源管理器、任务栏/桌面与隐私去广告开关。每次切换前自动保存注册表快照，随时可一键撤销还原。" />
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Tweaks}" Style="{StaticResource Grid}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="开启" Width="54" SortMemberPath="IsOn">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="分类" Width="135" SortMemberPath="Category">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="调优项目" Width="1.7*" SortMemberPath="Title">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CellText}"
                                               ToolTip="{Binding RegistryPath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="作用说明" Width="2.2*" SortMemberPath="Description">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CellMuted}"
                                               ToolTip="{Binding Description}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="状态" Width="80" SortMemberPath="StatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="105" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="定位注册表" Style="{StaticResource BtnSmall}"
                                            Command="{Binding DataContext.OpenTweakRegeditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- 子视图 2：网络与端口占用诊断 -->
        <Grid Grid.Row="1" Visibility="{Binding ShowPortsView, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToggleButton Grid.Column="0" Content="仅看监听端口 (LISTENING)" Style="{StaticResource Chip}"
                              Margin="0,0,10,0" VerticalAlignment="Center"
                              IsChecked="{Binding OnlyListeningPorts, Mode=TwoWay}" />

                <Grid Grid.Column="1" Margin="0,0,10,0">
                    <TextBox Style="{StaticResource SearchBox}"
                             Text="{Binding PortSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="按端口号 (如 8080 / 3000 / 443)、进程名或 PID 搜索…" Margin="12,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               FontSize="13" Foreground="{DynamicResource Brush.TextMuted}"
                               Visibility="{Binding PortSearchText, Converter={StaticResource EmptyToVis}}" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="刷新 DNS" Style="{StaticResource BtnBase}" Margin="0,0,6,0"
                            ToolTip="执行 ipconfig /flushdns 清理域名解析缓存"
                            Command="{Binding FlushDnsCommand}" />
                    <Button Content="重置 Winsock" Style="{StaticResource BtnBase}" Margin="0,0,6,0"
                            Command="{Binding ResetWinsockCommand}" />
                    <Button Content="重置 TCP/IP" Style="{StaticResource BtnBase}" Margin="0,0,6,0"
                            Command="{Binding ResetTcpIpCommand}" />
                    <Button Content="编辑 Hosts" Style="{StaticResource BtnBase}" Margin="0,0,6,0"
                            Command="{Binding EditHostsCommand}" />
                    <Button Content="刷新端口" Style="{StaticResource BtnPrimary}"
                            Command="{Binding RefreshPortsCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding PortSummaryText}" Style="{StaticResource Muted}"
                               Margin="14,10,14,6" />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Ports}" Style="{StaticResource Grid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="协议" Width="68" SortMemberPath="Protocol">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Protocol}" Style="{StaticResource CellMuted}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="本地端口" Width="90" SortMemberPath="LocalPort">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LocalPort}" Style="{StaticResource CellText}"
                                                   FontWeight="SemiBold" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="绑定地址" Width="135" SortMemberPath="LocalAddress">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LocalAddress}" Style="{StaticResource CellMuted}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="状态" Width="105" SortMemberPath="State">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding State}" Style="{StaticResource CellMuted}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="PID" Width="76" SortMemberPath="Pid">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Pid}" Style="{StaticResource CellMuted}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="占用进程" Width="1.2*" SortMemberPath="ProcessName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProcessName}" Style="{StaticResource CellText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="程序路径" Width="1.8*" SortMemberPath="ExecutablePath">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource CellMuted}"
                                                   ToolTip="{Binding ExecutablePath}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="205" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="目录" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                                    IsEnabled="{Binding HasExecutable}"
                                                    Command="{Binding DataContext.OpenPortProcessFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="复制" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.CopyPortInfoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="结束进程" Style="{StaticResource BtnSmall}"
                                                    Foreground="{DynamicResource Brush.Danger}"
                                                    IsEnabled="{Binding CanKill}"
                                                    Command="{Binding DataContext.KillPortProcessCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 子视图 3：系统深层面板直达 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowPanelsView, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Shortcuts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text}" />
                                        <Border Background="{DynamicResource Brush.Badge}" CornerRadius="6" Padding="6,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CommandLabel}" FontSize="11"
                                                       Foreground="{DynamicResource Brush.TextMuted}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="12"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="立即打开" Style="{StaticResource BtnBase}"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.OpenShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <!-- 页面级错误条：失败时统一展示，替代原先只靠底部状态栏 -->
        <Border Style="{StaticResource ErrorBar}" VerticalAlignment="Top"
                Panel.ZIndex="99" Margin="24,8,24,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" />
        </Border>
    </Grid>
</UserControl>
