<UserControl x:Class="WinKit.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <UserControl.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="CellMuted" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="86" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding SummaryText}" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="刷新 DNS" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                        Command="{Binding FlushDnsCommand}" />
                <Button Content="重置 Winsock" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                        Command="{Binding ResetWinsockCommand}" />
                <Button Content="重置 TCP/IP" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                        Command="{Binding ResetTcpCommand}" />
                <Button Content="网络设置" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                        Command="{Binding OpenNetworkSettingsCommand}" />
                <Button Content="刷新" Style="{StaticResource BtnPrimary}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Wi-Fi" Style="{StaticResource H2}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SSID" Style="{StaticResource KeyText}" />
                            <TextBlock Text="状态" Style="{StaticResource KeyText}" />
                            <TextBlock Text="信号" Style="{StaticResource KeyText}" />
                            <TextBlock Text="协议 / 信道" Style="{StaticResource KeyText}" />
                            <TextBlock Text="速率" Style="{StaticResource KeyText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Wifi.Ssid}" Style="{StaticResource CellText}" />
                            <TextBlock Text="{Binding Wifi.State}" Style="{StaticResource CellMuted}" />
                            <TextBlock Text="{Binding Wifi.Signal}" Style="{StaticResource CellMuted}" />
                            <TextBlock Style="{StaticResource CellMuted}">
                                <Run Text="{Binding Wifi.RadioType, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding Wifi.Channel, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource CellMuted}">
                                <Run Text="{Binding Wifi.ReceiveRate, Mode=OneWay}" />
                                <Run Text=" ↓ / " />
                                <Run Text="{Binding Wifi.TransmitRate, Mode=OneWay}" />
                                <Run Text=" ↑" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,10" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="系统代理" Style="{StaticResource H2}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="状态" Style="{StaticResource KeyText}" />
                            <TextBlock Text="代理服务器" Style="{StaticResource KeyText}" />
                            <TextBlock Text="自动配置脚本" Style="{StaticResource KeyText}" />
                            <TextBlock Text="例外" Style="{StaticResource KeyText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Proxy.StatusText}" Style="{StaticResource CellText}" />
                            <TextBlock Text="{Binding Proxy.Server}" Style="{StaticResource CellMuted}" />
                            <TextBlock Text="{Binding Proxy.AutoConfigUrl}" Style="{StaticResource CellMuted}" />
                            <TextBlock Text="{Binding Proxy.Bypass}" Style="{StaticResource CellMuted}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="网卡与 DNS" Style="{StaticResource H2}" Margin="14,12,14,6" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Adapters}" Style="{StaticResource Grid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="网卡" Width="1.4*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="类型" Width="70" SortMemberPath="TypeText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TypeText}" Style="{StaticResource CellMuted}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="状态" Width="80" SortMemberPath="StatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CellMuted}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="IPv4" Width="1.2*" SortMemberPath="Ipv4Text">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Ipv4Text}" Style="{StaticResource CellMuted}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="网关" Width="1.1*" SortMemberPath="GatewayText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding GatewayText}" Style="{StaticResource CellMuted}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="DNS" Width="1.4*" SortMemberPath="DnsText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DnsText}" Style="{StaticResource CellMuted}"
                                                   ToolTip="{Binding DnsText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="延迟与丢包（ICMP）" Style="{StaticResource H2}" Margin="14,12,14,6" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Pings}" Style="{StaticResource Grid}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="目标" Width="*" SortMemberPath="Label">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource CellText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="延迟" Width="1.4*" SortMemberPath="AvgMs">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LatencyText}" Style="{StaticResource CellMuted}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="丢包" Width="90" SortMemberPath="LossText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LossText}" Style="{StaticResource CellMuted}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="外网连通（TCP 443）" Style="{StaticResource H2}" Margin="14,12,14,6" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding TcpResults}" Style="{StaticResource Grid}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="站点" Width="*" SortMemberPath="Label">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource CellText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="耗时" Width="1.2*" SortMemberPath="ElapsedMs">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource CellMuted}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="DNS 解析耗时" Style="{StaticResource H2}" Margin="14,12,14,6" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DnsResults}" Style="{StaticResource Grid}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="域名" Width="*" SortMemberPath="Domain">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Domain}" Style="{StaticResource CellText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="耗时" Width="90" SortMemberPath="ElapsedMs">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource CellMuted}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="解析结果" Width="1.6*" SortMemberPath="Addresses">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Addresses}" Style="{StaticResource CellMuted}"
                                                       ToolTip="{Binding Addresses}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
