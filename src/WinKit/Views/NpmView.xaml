<UserControl x:Class="WinKit.Views.NpmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ErrorBar}" Margin="0,0,0,0"
                AutomationProperties.LiveSetting="Polite"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="npm 全局包" Style="{StaticResource H2}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="检查 registry 更新" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                            Command="{Binding CheckUpdatesCommand}" />
                    <Button Content="刷新环境" Style="{StaticResource BtnPrimary}"
                            ToolTip="重新识别 PATH 中的 Node.js/npm 并读取本机全局包"
                            Command="{Binding RefreshCommand}" />
                </WrapPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1.7*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="Node.js" Style="{StaticResource CellMuted}" />
                        <TextBlock Text="{Binding NodeVersionText}" Style="{StaticResource CellText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NodePathText}" Style="{StaticResource CellMuted}"
                                   TextWrapping="Wrap" ToolTip="{Binding NodePathText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="npm" Style="{StaticResource CellMuted}" />
                        <TextBlock Text="{Binding NpmVersionText}" Style="{StaticResource CellText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NpmPathText}" Style="{StaticResource CellMuted}"
                                   TextWrapping="Wrap" ToolTip="{Binding NpmPathText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="全局 prefix" Style="{StaticResource CellMuted}" />
                        <TextBlock Text="{Binding PrefixText}" Style="{StaticResource CellText}"
                                   TextWrapping="Wrap" ToolTip="{Binding PrefixText}" />
                        <TextBlock Text="{Binding LoadedAtText}" Style="{StaticResource CellMuted}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="安装全局包" Style="{StaticResource H2}" Margin="0,0,0,6" />
                <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                    <Grid Width="240" Margin="0,0,8,0">
                        <TextBox Text="{Binding PackageName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="npm 包名"
                                 ToolTip="npm 包名，作用域包使用 @scope/package 格式" />
                        <TextBlock Text="包名，例如 @scope/package" Margin="10,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Style="{StaticResource CellMuted}"
                                   Visibility="{Binding PackageName, Converter={StaticResource EmptyToVis}}" />
                    </Grid>
                    <Grid Width="160" Margin="0,0,8,0">
                        <TextBox Text="{Binding PackageVersionTag, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="版本或标签（可选）"
                                 ToolTip="可选完整版本或 dist-tag，例如 2.3.4、next" />
                        <TextBlock Text="版本 / tag（可选）" Margin="10,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Style="{StaticResource CellMuted}"
                                   Visibility="{Binding PackageVersionTag, Converter={StaticResource EmptyToVis}}" />
                    </Grid>
                    <Button Content="安装…" Style="{StaticResource BtnPrimary}"
                            Command="{Binding InstallCommand}" />
                    <TextBlock Text="{Binding InstallValidationText}" Style="{StaticResource CellMuted}"
                               Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center"
                               Margin="10,0,0,0" TextWrapping="Wrap" />
                </WrapPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                             AutomationProperties.Name="筛选 npm 全局包"
                             ToolTip="按包名或当前/最新版本筛选" />
                    <TextBlock Text="筛选包名 / 版本…" Margin="12,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Style="{StaticResource CellMuted}"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding SummaryText}" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="12,0" />
                <TextBlock Grid.Column="2" Text="命令运行中…" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <ProgressBar Grid.Row="4" Height="2" IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <Border Grid.Row="5" Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding VisiblePackages}" Style="{StaticResource Grid}"
                          IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="包名" Width="2*" MinWidth="160" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="已安装" Width="1*" MinWidth="95" SortMemberPath="Version">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Version}" Style="{StaticResource CellMuted}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Version}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="registry 最新版" Width="1*" MinWidth="120" SortMemberPath="LatestVersion">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LatestVersionText}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding LatestVersionText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellMuted}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMajorUpdate}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="175" MinWidth="175" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding UpdateButtonText}" Style="{StaticResource BtnSmall}"
                                                Margin="0,0,6,0" ToolTip="只更新此包至 latest；主版本更新会再次确认"
                                                Command="{Binding DataContext.UpdatePackageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="卸载…" Style="{StaticResource BtnSmall}"
                                                Command="{Binding DataContext.UninstallPackageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
