<UserControl x:Class="WinKit.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <UserControl.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="CellMuted" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}"
                     Text="{Binding LeftPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="左侧文件夹或文件" />
            <Button Grid.Column="1" Content="…" Style="{StaticResource BtnBase}" Margin="6,0,10,0"
                    Command="{Binding BrowseLeftCommand}" />
            <TextBox Grid.Column="2" Style="{StaticResource SearchBox}"
                     Text="{Binding RightPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="右侧文件夹或文件" />
            <Button Grid.Column="3" Content="…" Style="{StaticResource BtnBase}" Margin="6,0,0,0"
                    Command="{Binding BrowseRightCommand}" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox Content="递归子目录" IsChecked="{Binding Recursive, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="0,0,14,0" />
            <CheckBox Content="比对内容哈希（慢，但能识别大小与时间都相同的改动）"
                      IsChecked="{Binding CompareHash, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="0,0,14,0" />
            <CheckBox Content="只看差异" IsChecked="{Binding OnlyDifferences, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="0,0,14,0" />

            <Button Content="交换左右" Style="{StaticResource BtnSmall}" Margin="0,0,8,0"
                    Command="{Binding SwapCommand}" />
            <Button Content="开始对比" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"
                    Command="{Binding CompareCommand}" />
            <Button Content="取消" Style="{StaticResource BtnSmall}"
                    Command="{Binding CancelCommand}" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding SummaryText}" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ErrorText}" Style="{StaticResource Muted}"
                       Foreground="{StaticResource Brush.Danger}" VerticalAlignment="Center"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Filtered}" Style="{StaticResource Grid}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="差异" Width="95" SortMemberPath="KindText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding KindText}" Style="{StaticResource CellText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="相对路径" Width="2.4*" SortMemberPath="RelativePath">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RelativePath}" Style="{StaticResource CellText}"
                                           ToolTip="{Binding RelativePath}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="左侧大小" Width="95" SortMemberPath="LeftSize">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftSizeText}" Style="{StaticResource CellMuted}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="右侧大小" Width="95" SortMemberPath="RightSize">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RightSizeText}" Style="{StaticResource CellMuted}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="左侧时间" Width="125" SortMemberPath="LeftTime">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LeftTimeText}" Style="{StaticResource CellMuted}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="右侧时间" Width="125" SortMemberPath="RightTime">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RightTimeText}" Style="{StaticResource CellMuted}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="230" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="定位左" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.OpenLeftFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="定位右" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.OpenRightFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="复制左路径" Style="{StaticResource BtnSmall}"
                                            Command="{Binding DataContext.CopyLeftPathCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
