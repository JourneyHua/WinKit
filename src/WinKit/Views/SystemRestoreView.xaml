<UserControl x:Class="WinKit.Views.SystemRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding ProtectionText}" Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding FrequencyText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding ErrorText}" Style="{StaticResource Muted}"
                       Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Top"
                       MaxWidth="360" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="刷新" Style="{StaticResource BtnPrimary}" Command="{Binding RefreshCommand}"
                    Margin="0,0,8,0" />
            <TextBox Style="{StaticResource SearchBox}" Width="260" Margin="0,0,8,0"
                     Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="新还原点的说明文字，事后靠它认出这是哪一次改动" />
            <Button Content="创建还原点" Style="{StaticResource BtnBase}" Command="{Binding CreateCommand}"
                    Margin="0,0,8,0" />
            <Button Content="开启系统保护" Style="{StaticResource BtnBase}" Command="{Binding EnableProtectionCommand}"
                    Margin="0,0,8,0" />
            <Button Content="关闭系统保护" Style="{StaticResource BtnBase}" Command="{Binding DisableProtectionCommand}"
                    Foreground="{DynamicResource Brush.Danger}" Margin="0,0,8,0" />
            <Button Content="打开系统保护设置" Style="{StaticResource BtnBase}" Command="{Binding OpenSystemPropertiesCommand}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="还原点只回退系统文件、驱动、注册表设置与已安装程序，不会动个人文件。删除或关闭保护后无法找回；恢复到某个还原点会立刻重启机器。" />
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="还原点" Style="{StaticResource H2}" Margin="14,12,14,6" />

                <DataGrid Grid.Row="1" ItemsSource="{Binding Points}" Style="{StaticResource Grid}"
                          SelectedItem="{Binding SelectedPoint, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="序号" Width="70" SortMemberPath="SequenceNumber">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SequenceNumber}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="创建时间" Width="150" SortMemberPath="CreatedAt">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CreatedAt}" Style="{StaticResource CellText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="说明" Width="*" MinWidth="200" SortMemberPath="Description">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CellText}"
                                               ToolTip="{Binding Description}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="类型" Width="100" SortMemberPath="TypeText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeText}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="230" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="复制" Style="{StaticResource BtnSmall}" Margin="0,0,4,0"
                                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="恢复到此点" Style="{StaticResource BtnSmall}" Margin="0,0,4,0"
                                                ToolTip="会立即重启系统并回退到该还原点，请先保存工作"
                                                Command="{Binding DataContext.RestoreToCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="删除" Style="{StaticResource BtnSmall}"
                                                Foreground="{DynamicResource Brush.Danger}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" Style="{StaticResource EmptyState}"
                           Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"
                           Text="这里还没有还原点。&#x0a;先确认「系统保护」是开启状态，再点「创建还原点」。" />

                <Border Grid.Row="1" Style="{StaticResource BusyOverlay}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="正在与系统还原服务交互…" Style="{StaticResource BusyText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
