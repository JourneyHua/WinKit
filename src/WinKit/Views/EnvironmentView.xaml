<UserControl x:Class="WinKit.Views.EnvironmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">


    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}" Width="240"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="按变量名或值搜索" />

            <TextBlock Grid.Column="1" Text="{Binding SummaryText}" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" Margin="14,0,0,0" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="新增变量" Style="{StaticResource BtnSmall}" Margin="0,0,8,0"
                        Command="{Binding AddCommand}" />
                <Button Content="刷新" Style="{StaticResource BtnPrimary}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,10,0">
                <DataGrid ItemsSource="{Binding Vars}" Style="{StaticResource Grid}"
                          SelectedItem="{Binding SelectedVar, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="变量名" Width="1.1*" MinWidth="140" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}"
                                               FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="作用域" Width="85" SortMemberPath="ScopeText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ScopeText}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="值" Width="2*" MinWidth="160" SortMemberPath="Value">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayValue}" Style="{StaticResource CellMuted}"
                                               ToolTip="{Binding Value}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="200" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="编辑" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="复制" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="删除" Style="{StaticResource BtnSmall}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PATH" Style="{StaticResource H2}" VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <ToggleButton Content="当前用户" Style="{StaticResource Chip}" Margin="0,0,6,0"
                                          IsChecked="{Binding IsUserPath, Mode=OneWay}"
                                          Command="{Binding ShowUserPathCommand}" />
                            <ToggleButton Content="系统" Style="{StaticResource Chip}"
                                          IsChecked="{Binding IsMachinePath, Mode=OneWay}"
                                          Command="{Binding ShowMachinePathCommand}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="添加目录" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                    Command="{Binding AddPathEntryCommand}" />
                            <Button Content="应用顺序" Style="{StaticResource BtnPrimary}"
                                    Command="{Binding ApplyPathCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Margin="0,0,0,8"
                               Text="顺序即生效顺序（靠前优先）。只改 PATH 字符串，不删除任何目录；写入前会存快照。" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PathEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                                            Padding="0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Raw}" Style="{StaticResource CellText}"
                                                           ToolTip="{Binding Expanded}" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CellMuted}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="↑" Style="{StaticResource BtnSmall}" Padding="8,2"
                                                        Margin="0,0,4,0"
                                                        Command="{Binding DataContext.MovePathUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="↓" Style="{StaticResource BtnSmall}" Padding="8,2"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.MovePathDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="打开" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.OpenPathEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="移除" Style="{StaticResource BtnSmall}"
                                                        Command="{Binding DataContext.RemovePathEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Margin="0,8,0,0"
                               Text="提示：改完 PATH 后新开的程序立即生效；已经打开的程序（含资源管理器启动的）需要重启才会读到新值。" />
                </Grid>
            </Border>
        </Grid>
        <!-- 页面级错误条：失败时统一展示，替代原先只靠底部状态栏 -->
        <Border Style="{StaticResource ErrorBar}" VerticalAlignment="Top"
                Panel.ZIndex="99" Margin="24,8,24,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" />
        </Border>
    </Grid>
</UserControl>
