<UserControl x:Class="WinKit.Views.EventLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">


    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Content="近 7 天" Style="{StaticResource Chip}" Margin="0,0,6,0"
                              IsChecked="{Binding Is7Days, Mode=OneWay}"
                              Command="{Binding SetDaysCommand}" CommandParameter="7" />
                <ToggleButton Content="近 30 天" Style="{StaticResource Chip}"
                              IsChecked="{Binding Is30Days, Mode=OneWay}"
                              Command="{Binding SetDaysCommand}" CommandParameter="30" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="事件查看器" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                        Command="{Binding OpenEventViewerCommand}" />
                <Button Content="刷新" Style="{StaticResource BtnPrimary}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Muted}"
                           Foreground="{DynamicResource Brush.Danger}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Filtered}" Style="{StaticResource Grid}"
                      SelectedItem="{Binding SelectedGroup, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="次数" Width="80" SortMemberPath="Count">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CountText}" Style="{StaticResource CellText}" FontWeight="SemiBold" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="分类" Width="140" SortMemberPath="Category">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Category}" Style="{StaticResource CellMuted}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="来源" Width="1.5*" MinWidth="180" SortMemberPath="Provider">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Provider}" Style="{StaticResource CellText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="事件 ID" Width="95" SortMemberPath="EventId">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding EventId}" Style="{StaticResource CellMuted}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="级别" Width="70" SortMemberPath="LevelText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LevelText}" Style="{StaticResource CellMuted}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="最后出现" Width="110" SortMemberPath="LastText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastText}" Style="{StaticResource CellMuted}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="示例数据" Width="2.4*" MinWidth="220" SortMemberPath="Sample">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Sample}" Style="{StaticResource CellMuted}"
                                           ToolTip="{Binding Sample}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="90" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="复制详情" Style="{StaticResource BtnSmall}"
                                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0"
                Visibility="{Binding SelectedGroup, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}">
            <StackPanel>
                <TextBlock Text="{Binding SelectedGroup.Provider}" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding SelectedGroup.Sample}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
