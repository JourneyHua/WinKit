<UserControl x:Class="WinKit.Views.RegistryAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">


    <Grid Margin="24,16,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,12,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="分类" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="全分类体检" Style="{StaticResource BtnSmall}"
                            ToolTip="一次性扫描全部 7 个分类并统计各分类可疑项数量"
                            Command="{Binding ScanAllCategoriesCommand}" />
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               TextWrapping="Wrap" Margin="0,1,6,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource Brush.Badge}" CornerRadius="8" Padding="6,1"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding CountText}" FontSize="11"
                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="搜索名称 / 路径…" Margin="12,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" FontSize="13"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <ToggleButton Content="只看可疑项" Style="{StaticResource Chip}" Margin="0,0,8,0"
                                  IsChecked="{Binding OnlyInvalid, Mode=TwoWay}" />
                    <Button Content="{Binding RemoveAllText}" Style="{StaticResource BtnDanger}" Margin="0,0,8,0"
                            Visibility="{Binding CanRemoveAll, Converter={StaticResource BoolToVis}}"
                            Command="{Binding RemoveAllCommand}" />
                    <Button Content="全分类体检" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                            Command="{Binding ScanAllCategoriesCommand}" />
                    <Button Content="重新扫描" Style="{StaticResource BtnBase}" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10"
                    Background="{DynamicResource Brush.WarnSoft}" BorderBrush="{DynamicResource Brush.WarnSoftBorder}"
                    Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding NoteText}" Style="{StaticResource Muted}"
                           Foreground="{DynamicResource Brush.Warn}" />
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding SummaryText}" Style="{StaticResource Muted}"
                               Margin="14,10,14,6" />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" Style="{StaticResource Grid}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制注册表路径"
                                          Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="在注册表编辑器 (regedit) 中定位"
                                          Command="{Binding PlacementTarget.DataContext.OpenRegeditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="复制详情内容"
                                          Command="{Binding PlacementTarget.DataContext.CopyDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="名称" Width="2*" MinWidth="200" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}"
                                                   ToolTip="{Binding KeyPath}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="详情" Width="3*" SortMemberPath="Detail">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CellMuted}"
                                                   ToolTip="{Binding Detail}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="风险" Width="76" SortMemberPath="Risk">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RiskText}" Style="{StaticResource CellMuted}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="状态" Width="76" SortMemberPath="IsInvalid">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CellMuted}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="210" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="定位" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                                    ToolTip="在注册表编辑器 (regedit) 中定位"
                                                    Command="{Binding DataContext.OpenRegeditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="复制路径" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="清理" Style="{StaticResource BtnSmall}"
                                                    Foreground="{DynamicResource Brush.Danger}"
                                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1" Text="当前分类下没有符合条件的条目" Style="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Items.Count, Converter={StaticResource EmptyToVis}}" />
                </Grid>
            </Border>
        </Grid>
        <!-- 页面级错误条：失败时统一展示，替代原先只靠底部状态栏 -->
        <Border Style="{StaticResource ErrorBar}" VerticalAlignment="Top"
                Panel.ZIndex="99" Margin="24,8,24,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" />
        </Border>
    </Grid>
</UserControl>
