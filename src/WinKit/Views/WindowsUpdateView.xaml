<UserControl x:Class="WinKit.Views.WindowsUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">


    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="更新状态" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding NoteText}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="更新设置" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                                Command="{Binding OpenSettingsCommand}" />
                        <Button Content="刷新" Style="{StaticResource BtnPrimary}"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>

                <WrapPanel>
                    <Button Content="暂停 7 天" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                            Command="{Binding Pause7Command}" />
                    <Button Content="暂停 14 天" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                            Command="{Binding Pause14Command}" />
                    <Button Content="暂停 35 天" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                            Command="{Binding Pause35Command}" />
                    <Button Content="恢复更新" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                            Command="{Binding ResumeCommand}" />
                    <Button Content="清理更新缓存" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                            Command="{Binding CleanCacheCommand}" />
                    <Button Content="重启更新服务" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                            Command="{Binding RestartServiceCommand}" />
                    <Button Content="打开缓存目录" Style="{StaticResource BtnSmall}"
                            Command="{Binding OpenCacheFolderCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10"
                Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.AccentSoftBorder}">
            <TextBlock Style="{StaticResource Muted}" Foreground="{DynamicResource Brush.Accent}"
                       Text="下面列出系统记录的已安装补丁（来自本地更新代理，不联网）。暂停开关写的是 USO 策略键，全部可撤销；企业策略环境下可能被接管。" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Installed}" Style="{StaticResource Grid}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="补丁" Width="2.6*" SortMemberPath="Title">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource CellText}"
                                           ToolTip="{Binding Title}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="KB 编号" Width="150" SortMemberPath="Kb">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Kb}" Style="{StaticResource CellMuted}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="类别" Width="1.4*" SortMemberPath="CategoryText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CategoryText}" Style="{StaticResource CellMuted}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="安装时间" Width="110" SortMemberPath="InstalledText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding InstalledText}" Style="{StaticResource CellMuted}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="大小" Width="90" SortMemberPath="SizeText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource CellMuted}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <!-- 页面级错误条：失败时统一展示，替代原先只靠底部状态栏 -->
        <Border Style="{StaticResource ErrorBar}" VerticalAlignment="Top"
                Panel.ZIndex="99" Margin="24,8,24,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" />
        </Border>
    </Grid>
</UserControl>
