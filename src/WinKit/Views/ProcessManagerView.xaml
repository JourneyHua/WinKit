<UserControl x:Class="WinKit.Views.ProcessManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding SummaryText}" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ErrorText}" Style="{StaticResource Muted}"
                       Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center"
                       MaxWidth="420" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="刷新" Style="{StaticResource BtnPrimary}" Command="{Binding RefreshCommand}"
                    Margin="0,0,8,0" />
            <TextBox Style="{StaticResource SearchBox}" Width="260" Margin="0,0,8,0"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="按进程名、描述、公司、映像路径或 PID 筛选；清空即显示全部" />
            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                       Text="先刷新一次再筛选；行尾的「结束」只杀该进程，「进程树」连同它启动的子进程一起杀。" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="进程" Style="{StaticResource H2}" Margin="14,12,14,6" />

                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" Style="{StaticResource Grid}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="进程名" Width="*" MinWidth="140" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}"
                                               ToolTip="{Binding ExecutablePath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PID" Width="64" SortMemberPath="Pid">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Pid}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="描述" Width="*" MinWidth="140" SortMemberPath="Description">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CellMuted}"
                                               ToolTip="{Binding Company}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="内存" Width="88" SortMemberPath="WorkingSetBytes">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MemoryText}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="线程" Width="64" SortMemberPath="ThreadCount">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ThreadCount}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="启动时间" Width="130" SortMemberPath="StartTimeText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StartTimeText}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="236" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="结束" Style="{StaticResource BtnSmall}" Margin="0,0,4,0"
                                                Foreground="{DynamicResource Brush.Danger}"
                                                Command="{Binding DataContext.KillCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="进程树" Style="{StaticResource BtnSmall}" Margin="0,0,4,0"
                                                ToolTip="连同它启动的所有子进程一起结束"
                                                Command="{Binding DataContext.KillTreeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="目录" Style="{StaticResource BtnSmall}" Margin="0,0,4,0"
                                                ToolTip="在资源管理器里定位该程序的 exe"
                                                Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="复制" Style="{StaticResource BtnSmall}"
                                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" Style="{StaticResource EmptyState}"
                           Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                    还没有进程数据。<LineBreak />
                    点「刷新」枚举一次；WinKit 只做「看 + 结束」，不做句柄与模块级分析。
                </TextBlock>

                <Border Grid.Row="1" Style="{StaticResource BusyOverlay}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="正在处理进程…" Style="{StaticResource BusyText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
