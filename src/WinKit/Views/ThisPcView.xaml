<UserControl x:Class="WinKit.Views.ThisPcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <UserControl.Resources>
        <Style x:Key="RowCheck" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="RowSub" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <DataTemplate x:Key="SimpleRow">
            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                              IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource RowSub}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource RowSub}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="此电脑里的用户文件夹" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                               Text="取消勾选后该文件夹不再出现在此电脑中（数据不删除，只隐藏显示）。" />
                    <ItemsControl ItemsSource="{Binding Folders}" ItemTemplate="{StaticResource SimpleRow}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding Nodes.Count, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}">
                <StackPanel>
                    <TextBlock Text="系统节点" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                               Text="控制面板、网络、用户文件夹等节点。隐藏第三方节点会删除其注册的命名空间项，可通过“撤销上一步”恢复。" />
                    <ItemsControl ItemsSource="{Binding Nodes}" ItemTemplate="{StaticResource SimpleRow}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="驱动器可见性" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                               Text="通过 NoDrives 策略隐藏盘符。只影响资源管理器显示，不会改变盘符字母或磁盘数据。" />
                    <ItemsControl ItemsSource="{Binding Drives}" ItemTemplate="{StaticResource SimpleRow}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
