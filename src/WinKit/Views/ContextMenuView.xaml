<UserControl x:Class="WinKit.Views.ContextMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <UserControl.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="CellMuted" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="RowCheck" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="DomainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <ToggleButton Content="一级菜单（右键直接看到的）" Style="{StaticResource Chip}"
                          IsChecked="{Binding ShowNewMenu, Mode=OneWay}"
                          Command="{Binding ShowNewMenuCommand}" Margin="0,0,8,0" />
            <ToggleButton Content="经典菜单（显示更多选项里的）" Style="{StaticResource Chip}"
                          IsChecked="{Binding ShowClassicMenu, Mode=OneWay}"
                          Command="{Binding ShowClassicMenuCommand}" />
            <Button Content="重新扫描" Style="{StaticResource BtnSmall}" Margin="16,0,0,0"
                    Command="{Binding RefreshCommand}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid Visibility="{Binding ShowNewMenu, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Background="{StaticResource Brush.WarnSoft}"
                        BorderBrush="#FFE8C46B" Padding="14,10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="关于一级菜单的能力边界" Style="{StaticResource H2}"
                                   Foreground="{StaticResource Brush.Warn}" />
                        <TextBlock Text="{Binding NewMenuHint}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   Foreground="{StaticResource Brush.Warn}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="196" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
                        <ListBox ItemsSource="{Binding NewDomains}" Style="{StaticResource DomainList}"
                                 SelectedItem="{Binding SelectedNewDomain, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#FFF1EFE8" CornerRadius="8" Padding="6,1">
                                            <TextBlock Text="{Binding Count}" FontSize="11"
                                                       Foreground="{StaticResource Brush.TextMuted}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding NewMenuCountText}" Style="{StaticResource Muted}"
                                       Margin="14,10,14,6" />

                            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredNewItems}" Style="{StaticResource Grid}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="60" Header="屏蔽">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource RowCheck}"
                                                          IsChecked="{Binding IsBlockedOn, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="软件" Width="1.8*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CellText}"
                                                           ToolTip="{Binding Package}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="作用域" Width="1.4*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ScopeText}" Style="{StaticResource CellMuted}"
                                                           ToolTip="{Binding ScopeText}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="继承" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="继承" Style="{StaticResource CellMuted}"
                                                           Foreground="{StaticResource Brush.Warn}"
                                                           ToolTip="该软件只声明了文件夹作用域，驱动器菜单会一并显示"
                                                           Visibility="{Binding ShowDriveInherited, Converter={StaticResource BoolToVis}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="菜单项" Width="1.1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ClassNames}" Style="{StaticResource CellMuted}"
                                                           ToolTip="{Binding ClsidText}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="安装位置" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Location}" Style="{StaticResource CellMuted}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="状态" Width="72">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CellMuted}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="操作" Width="132">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{Binding BlockToggleText}" Style="{StaticResource BtnSmall}"
                                                            Margin="0,0,6,0"
                                                            Command="{Binding DataContext.ToggleBlockCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="卸载" Style="{StaticResource BtnSmall}"
                                                            Foreground="{StaticResource Brush.Danger}"
                                                            Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="1" Text="当前分组下没有条目" Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding FilteredNewItems.Count, Converter={StaticResource EmptyToVis}}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding ShowClassicMenu, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="196" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
                    <ListBox ItemsSource="{Binding Domains}" Style="{StaticResource DomainList}"
                             SelectedItem="{Binding SelectedDomain, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="#FFF1EFE8" CornerRadius="8" Padding="6,1">
                                        <TextBlock Text="{Binding Count}" FontSize="11"
                                                   Foreground="{StaticResource Brush.TextMuted}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox Style="{StaticResource SearchBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="按名称、发布者、命令路径或注册表路径搜索" />
                            <TextBlock Text="搜索名称 / 发布者 / 命令路径…" Margin="12,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       FontSize="13" Foreground="{StaticResource Brush.TextMuted}"
                                       Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <ToggleButton Content="仅第三方" Style="{StaticResource Chip}" Margin="0,0,6,0"
                                          IsChecked="{Binding OnlyThirdParty, Mode=TwoWay}" />
                            <ToggleButton Content="仅已禁用" Style="{StaticResource Chip}"
                                          IsChecked="{Binding OnlyDisabled, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <DataGrid ItemsSource="{Binding Entries}" Style="{StaticResource Grid}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="56" Header="启用">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource RowCheck}"
                                                          IsChecked="{Binding IsEnabledOn, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="名称" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CellText}"
                                                           ToolTip="{Binding RegistryPath}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="发布者" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Publisher}" Style="{StaticResource CellMuted}"
                                                           ToolTip="{Binding CommandPath}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="范围" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DomainTitle}" Style="{StaticResource CellMuted}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="状态" Width="72">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CellMuted}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="操作" Width="132">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="改名" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="删除" Style="{StaticResource BtnSmall}"
                                                            Foreground="{StaticResource Brush.Danger}"
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="当前筛选下没有条目" Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Entries.Count, Converter={StaticResource EmptyToVis}}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
