<UserControl x:Class="WinKit.Views.SmartAttributeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding SummaryText}" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" Text="{Binding ErrorText}" Style="{StaticResource Muted}"
                       Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center"
                       MaxWidth="420" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="刷新" Style="{StaticResource BtnPrimary}" Command="{Binding RefreshCommand}"
                    Margin="0,0,8,0" />
            <ComboBox Width="300" Margin="0,0,8,0" VerticalContentAlignment="Center"
                      ItemsSource="{Binding Disks}" DisplayMemberPath="DisplayName"
                      SelectedItem="{Binding SelectedDisk, Mode=TwoWay}"
                      ToolTip="选择要看哪块物理磁盘" />
            <Button Content="导出 CSV" Style="{StaticResource BtnBase}" Command="{Binding ExportCommand}"
                    Margin="0,0,8,0" />
            <Button Content="打开导出目录" Style="{StaticResource BtnBase}" Command="{Binding OpenExportFolderCommand}" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="SMART 的「当前值/最差/阈值」是硬盘固件给的 0~255 归一化分数：越低越糟，跌到阈值以下厂家就是在说「该换了」。「原始值」才是计数本身。这些数据只有管理员能读；USB 外置盘、RAID 卡后面的盘和虚拟盘通常读不到——那是控制器不透传，不是盘坏了。" />
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="SMART 原始属性" Style="{StaticResource H2}" Margin="14,12,14,6" />

                <DataGrid Grid.Row="1" ItemsSource="{Binding Attributes}" Style="{StaticResource Grid}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ID" Width="60" SortMemberPath="Id">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="属性" Width="*" MinWidth="150" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="当前值" Width="80" SortMemberPath="Value">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="最差值" Width="80" SortMemberPath="Worst">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Worst}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="阈值" Width="70" SortMemberPath="Threshold">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Threshold}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="原始值" Width="*" MinWidth="150" SortMemberPath="RawText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RawText}" Style="{StaticResource CellMuted}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="判定" Width="80" SortMemberPath="Level">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LevelText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="warn">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="bad">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="90" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="复制" Style="{StaticResource BtnSmall}"
                                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="1" Style="{StaticResource EmptyState}"
                           Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                    这块盘没有可读的 SMART 属性。<LineBreak />
                    先点「刷新」（需要管理员权限）；USB 外置盘、RAID 与虚拟盘读不到属正常，可以回「磁盘健康」页看汇总结论。
                </TextBlock>

                <Border Grid.Row="1" Style="{StaticResource BusyOverlay}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="正在读取 SMART 原始属性…" Style="{StaticResource BusyText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
