<UserControl x:Class="WinKit.Views.DriverManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">

    <UserControl.Resources>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="CellMuted" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="驱动类别" Style="{StaticResource H2}" Margin="16,14,16,6" />

                <ListBox Grid.Row="1" ItemsSource="{Binding Classes}"
                         SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                                <Border Grid.Column="1" Background="#FFF1EFE8" CornerRadius="8" Padding="6,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Count}" FontSize="11"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按驱动包名 (oem*.inf)、原始 .inf、厂商、数字签名或类别搜索" />
                    <TextBlock Text="搜索驱动包 / 厂商 / 数字签名…" Margin="12,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               FontSize="13" Foreground="{StaticResource Brush.TextMuted}"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}}" />
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="{Binding InstallAllUpdatesText}" Style="{StaticResource BtnPrimary}" Margin="0,0,6,0"
                            Visibility="{Binding HasWindowsUpdates, Converter={StaticResource BoolToVis}}"
                            Command="{Binding InstallAllWindowsUpdatesCommand}" />
                    <Button Content="检查官方更新" Style="{StaticResource BtnBase}" Margin="0,0,6,0"
                            ToolTip="通过 Windows Update 检索微软官方 WHQL 驱动更新"
                            Command="{Binding CheckWindowsUpdatesCommand}" />
                    <Button Content="安装 .inf…" Style="{StaticResource BtnBase}" Margin="0,0,6,0"
                            ToolTip="选择本地 .inf 驱动包调用 pnputil 安装或升级"
                            Command="{Binding InstallLocalInfCommand}" />
                    <Button Content="{Binding RestoreBackupText}" Style="{StaticResource BtnBase}" Margin="0,0,6,0"
                            Visibility="{Binding HasBackups, Converter={StaticResource BoolToVis}}"
                            Command="{Binding RestoreFromBackupCommand}" />
                    <Button Content="设备管理器" Style="{StaticResource BtnBase}" Margin="0,0,6,0"
                            ToolTip="打开系统设备管理器 (devmgmt.msc)"
                            Command="{Binding OpenDeviceManagerCommand}" />
                    <Button Content="扫描硬件" Style="{StaticResource BtnBase}" Margin="0,0,6,0"
                            Command="{Binding ScanHardwareCommand}" />
                    <Button Content="重新扫描" Style="{StaticResource BtnBase}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10"
                    Background="{StaticResource Brush.WarnSoft}" BorderBrush="#FFE8C46B"
                    Visibility="{Binding HasWindowsUpdates, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="检测到微软 Windows Update 官方驱动更新" Style="{StaticResource H2}"
                               Foreground="{StaticResource Brush.Warn}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding WindowsUpdates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                   Foreground="{StaticResource Brush.Text}" />
                                        <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                   Foreground="{StaticResource Brush.TextMuted}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="下载并安装" Style="{StaticResource BtnSmall}"
                                            VerticalAlignment="Center" Margin="10,0,0,0"
                                            Command="{Binding DataContext.InstallWindowsUpdateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,8,14,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding SummaryText}" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Content="全部级别" Style="{StaticResource Chip}" Margin="0,0,6,0"
                                          Padding="10,3" FontSize="12"
                                          IsChecked="{Binding IsLevelAll, Mode=OneWay}"
                                          Command="{Binding FilterLevelAllCommand}" />
                            <ToggleButton Content="核心驱动" Style="{StaticResource Chip}" Margin="0,0,6,0"
                                          Padding="10,3" FontSize="12"
                                          IsChecked="{Binding IsLevelCritical, Mode=OneWay}"
                                          Command="{Binding FilterLevelCriticalCommand}" />
                            <ToggleButton Content="普通外设" Style="{StaticResource Chip}"
                                          Padding="10,3" FontSize="12"
                                          IsChecked="{Binding IsLevelPeripheral, Mode=OneWay}"
                                          Command="{Binding FilterLevelPeripheralCommand}" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Drivers}" Style="{StaticResource Grid}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="复制驱动包信息"
                                          Command="{Binding PlacementTarget.DataContext.CopyDriverInfoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="导出驱动备份到本地"
                                          Command="{Binding PlacementTarget.DataContext.ExportDriverCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="打开驱动备份目录"
                                          Command="{Binding PlacementTarget.DataContext.OpenBackupFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="打开系统设备管理器 (devmgmt.msc)"
                                          Command="{Binding PlacementTarget.DataContext.OpenDeviceManagerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="驱动包 (.inf)" Width="1.4*" SortMemberPath="DisplayTitle">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource CellText}"
                                                   ToolTip="{Binding DisplayTitle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="设备类别" Width="1.1*" SortMemberPath="ClassTitle">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ClassTitle}" Style="{StaticResource CellMuted}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="厂商" Width="1.1*" SortMemberPath="Provider">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Provider}" Style="{StaticResource CellMuted}"
                                                   ToolTip="{Binding Signer}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="版本与日期" Width="1.2*" SortMemberPath="VersionAndDate">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding VersionAndDate}" Style="{StaticResource CellMuted}"
                                                   ToolTip="{Binding VersionAndDate}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="数字签名" Width="1.1*" SortMemberPath="Signer">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Signer}" Style="{StaticResource CellMuted}"
                                                   ToolTip="{Binding Signer}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="级别" Width="76" SortMemberPath="RiskText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RiskText}" Style="{StaticResource CellMuted}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="140" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="备份" Style="{StaticResource BtnSmall}" Margin="0,0,6,0"
                                                    ToolTip="导出完整驱动包至本地备份目录"
                                                    Command="{Binding DataContext.ExportDriverCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="卸载" Style="{StaticResource BtnSmall}"
                                                    Foreground="{StaticResource Brush.Danger}"
                                                    Command="{Binding DataContext.UninstallDriverCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1" Text="当前类别或筛选下没有第三方驱动包" Style="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Drivers.Count, Converter={StaticResource EmptyToVis}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
