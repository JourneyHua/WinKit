<UserControl x:Class="WinKit.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="DetailText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具条 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding SummaryText}" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="系统信息" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                        Command="{Binding OpenSystemInfoCommand}" />
                <Button Content="任务管理器" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                        Command="{Binding OpenTaskManagerCommand}" />
                <Button Content="刷新" Style="{StaticResource RefreshBtn}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- 关键指标：一排大数字，先看有没有问题 -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding KeyMetrics}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}"
                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                       ToolTip="{Binding Value}" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CellSub}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 明细卡片：自适应两列（原先 Width=540 写死，924px 里只能排一列，右侧空 368px） -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,2,0,10" />

                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Brush.Border}"
                                                        BorderThickness="0,0,0,1" Padding="0,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                   Style="{StaticResource LabelText}" />

                                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Value}" Style="{StaticResource ValueText}"
                                                                       ToolTip="{Binding Value}" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource DetailText}"
                                                                       ToolTip="{Binding Detail}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Style="{StaticResource Badge}" Margin="0,0,6,0"
                                                                    Visibility="{Binding LevelText, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}">
                                                                <TextBlock Text="{Binding LevelText}" Style="{StaticResource BadgeText}" />
                                                            </Border>
                                                            <Button Content="复制" Style="{StaticResource BtnSmall}"
                                                                    Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="正在读取系统信息…" Style="{StaticResource EmptyState}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
