<UserControl x:Class="WinKit.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面级错误条独立占行，失败时保留工具栏与恢复操作 -->
        <Border Grid.Row="0" Style="{StaticResource ErrorBar}" Margin="24,16,24,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>

    <Grid Grid.Row="1" Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,10" Margin="0,0,14,0"
                    Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.AccentSoftBorder}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ScoreText}" FontSize="34" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="/ 100" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding GradeText}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding GeneratedText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}"
                           Foreground="{DynamicResource Brush.Accent}" Margin="0,2,0,0"
                           Visibility="{Binding ProgressText, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding FeedbackText}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding FeedbackText, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding GenerateText}" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"
                        Command="{Binding GenerateCommand}" />
                <Button Content="保存 Markdown" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                        Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}"
                        Command="{Binding ExportMarkdownCommand}" />
                <Button Content="保存 JSON" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                        Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}"
                        Command="{Binding ExportJsonCommand}" />
                <Button Content="打开报告文件夹" Style="{StaticResource BtnSmall}"
                        Visibility="{Binding HasReportFolder, Converter={StaticResource BoolToVis}}"
                        Command="{Binding OpenReportFolderCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="定期维护" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding MaintenanceText}" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LastOutcomeText}" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   Visibility="{Binding LastOutcomeText, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
                        <TextBlock Text="{Binding MaintenanceProgress}" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding MaintenanceProgress, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Content="启用每周维护…" Style="{StaticResource BtnBase}"
                                Visibility="{Binding ShowEnableTask, Converter={StaticResource BoolToVis}}"
                                Command="{Binding RegisterTaskCommand}" />
                        <Button Content="以管理员身份启用维护…" Style="{StaticResource BtnBase}"
                                Visibility="{Binding ShowElevateForTask, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.ElevateCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="立即维护…" Style="{StaticResource BtnBase}" Margin="0,0,8,0"
                                Visibility="{Binding ShowRunTask, Converter={StaticResource BoolToVis}}"
                                Command="{Binding RunTaskNowCommand}" />
                        <Button Content="关闭每周维护…" Style="{StaticResource BtnSmall}"
                                Visibility="{Binding ShowDisableTask, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DeleteTaskCommand}" />
                        <Button Content="以管理员身份重启…" Style="{StaticResource BtnSmall}"
                                ToolTip="读取或关闭 Windows 维护安排可能需要管理员权限"
                                Visibility="{Binding ShowElevateToDisable, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.ElevateCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="刷新维护状态" Style="{StaticResource BtnSmall}"
                                Visibility="{Binding ShowRefreshTask, Converter={StaticResource BoolToVis}}"
                                Command="{Binding RefreshTaskCommand}" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="每周维护会清理过期的临时文件和缓存，并保存体检报告，不会清空回收站。" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource H2}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Muted}"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                                                    Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="0.9*" />
                                                        <ColumnDefinition Width="1.4*" />
                                                        <ColumnDefinition Width="0.9*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                               Style="{StaticResource CellMuted}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                               Style="{StaticResource CellText}"
                                                               ToolTip="{Binding Value}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                               Style="{StaticResource CellMuted}"
                                                               ToolTip="{Binding Detail}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
    </Grid>
</UserControl>
