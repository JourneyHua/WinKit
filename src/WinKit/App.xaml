<Application x:Class="WinKit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:WinKit.Core"
             xmlns:vm="clr-namespace:WinKit.ViewModels"
             xmlns:views="clr-namespace:WinKit.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <core:BoolToVisibilityConverter x:Key="BoolToVis" />
            <core:EmptyToVisibilityConverter x:Key="EmptyToVis" />
            <core:BoolToTextConverter x:Key="BoolToText" />

            <DataTemplate DataType="{x:Type vm:ContextMenuViewModel}">
                <views:ContextMenuView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ThisPcViewModel}">
                <views:ThisPcView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NavPaneViewModel}">
                <views:NavPaneView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BackupViewModel}">
                <views:BackupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RegistryAuditViewModel}">
                <views:RegistryAuditView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AppManagerViewModel}">
                <views:AppManagerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DriverManagerViewModel}">
                <views:DriverManagerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StartupServiceViewModel}">
                <views:StartupServiceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SystemCleanViewModel}">
                <views:SystemCleanView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SystemTweakViewModel}">
                <views:SystemTweakView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
                <views:OverviewView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FileLockViewModel}">
                <views:FileLockView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EventLogViewModel}">
                <views:EventLogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WindowsUpdateViewModel}">
                <views:WindowsUpdateView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NetworkViewModel}">
                <views:NetworkView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiffViewModel}">
                <views:DiffView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DuplicateViewModel}">
                <views:DuplicateView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FileAssocViewModel}">
                <views:FileAssocView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
